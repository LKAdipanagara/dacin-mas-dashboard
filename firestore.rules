rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hanya pengguna yang sudah login (dibuat manual lewat Firebase Console
    // di tab Authentication) yang boleh membaca & menulis data proyek.
    match /proyek/{docId} {
      allow read, write: if request.auth != null;
    }

    // Pengaturan target omzet & parameter pajak — juga hanya untuk pengguna login.
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // Tolak semua akses ke koleksi lain yang tidak didefinisikan di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
